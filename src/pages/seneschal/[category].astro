---
import Layout from "../../layouts/Layout.astro";
import { SENESCHAL_CATEGORIES, type SeneschalCategory } from "../../lib/seneschal";

export const prerender = true;

export async function getStaticPaths() {
  return SENESCHAL_CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

interface Props {
  category: SeneschalCategory;
}

const { category } = Astro.props;
const available = category.tools.filter((tool) => tool.status === "available");
const soon = category.tools.filter((tool) => tool.status === "soon");
const featured = available[0];
const isEchoppes = category.slug === "echoppes";
---

<Layout
  title={`${category.name} — Le Sénéchal · Le Trône des Lames`}
  description={`${category.description} Outils de calcul pour Renaissance Kingdoms, réglés sur les règles à jour.`}
>
  <nav aria-label="Fil d’Ariane" class="border-b border-gold/10 bg-ink-2/30">
    <ol
      class="container-tdl flex flex-wrap items-center gap-2 py-3 text-[0.625rem] uppercase tracking-[0.14em] text-parchment-dim"
    >
      <li><a href="/seneschal" class="transition-colors hover:text-gold">Le Sénéchal</a></li>
      <li aria-hidden="true" class="text-gold/40">/</li>
      <li aria-current="page" class="text-parchment">{category.name}</li>
    </ol>
  </nav>

  <section class="relative overflow-hidden border-b border-gold/15 bg-ink-2/40">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_55%_60%_at_72%_0%,rgba(201,162,39,0.13),transparent_70%)]"
      aria-hidden="true"
    >
    </div>

    <div class="container-tdl relative py-12 sm:py-16">
      <p class="label-caps reveal">{category.kicker}</p>
      <h1
        class="reveal mt-3 font-display text-4xl font-bold tracking-[0.05em] text-parchment sm:text-5xl"
      >
        {category.name}
      </h1>
      <div class="rule-gold reveal my-5 w-28"></div>
      <p class="reveal max-w-xl text-sm leading-relaxed text-parchment-dim sm:text-base">
        {category.description}
      </p>
      <p class="reveal mt-5 text-[0.625rem] uppercase tracking-[0.16em] text-parchment-dim/80">
        {category.tools.length} outils
        <span class="px-1.5 text-gold/40" aria-hidden="true">◆</span>
        {available.length > 0
          ? `${available.length} disponible${available.length > 1 ? "s" : ""}`
          : "Aucun disponible"}
      </p>
    </div>
  </section>

  <div class="container-tdl py-12 sm:py-16">
    {featured && (
      <section aria-labelledby="disponible-titre">
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
          <h2 id="disponible-titre" class="label-caps">Disponible</h2>
          <p class="text-[0.625rem] uppercase tracking-[0.14em] text-parchment-dim/70">
            Règles vérifiées en octobre 2026
          </p>
        </div>

        <article class="card-dark texture-noise mt-4 grid gap-6 p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-12">
          <div>
            <span class="border border-gold/40 px-2 py-0.5 text-[0.5rem] font-semibold uppercase tracking-[0.16em] text-gold">
              {featured.tag ?? "Disponible"}
            </span>
            <h3 class="mt-3 font-display text-2xl tracking-[0.05em] text-parchment sm:text-3xl">
              {featured.name}
            </h3>
            <p class="mt-3 max-w-xl text-sm leading-relaxed text-parchment-dim">
              {featured.summary}
            </p>
            {featured.slug === "elevage-de-vaches" && (
              <p class="mt-4 text-[0.625rem] uppercase tracking-[0.16em] text-parchment-dim/70">
                4 vaches · traite · carcasses · outils
              </p>
            )}
          </div>

          <a
            href={featured.href ?? `/seneschal/${category.slug}/${featured.slug}`}
            class="btn-gold w-full justify-center sm:w-auto"
          >
            Ouvrir le calculateur
          </a>
        </article>
      </section>
    )}

    {isEchoppes && (
      <section aria-labelledby="echoppes-titre">
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
          <h2 id="echoppes-titre" class="label-caps">Le registre des échoppes</h2>
          <p class="text-[0.625rem] uppercase tracking-[0.14em] text-parchment-dim/70">
            {soon.length} outils prévus
          </p>
        </div>

        <div class="card-dark texture-noise mt-4 flex flex-col items-center px-6 py-12 text-center">
          <svg viewBox="0 0 24 24" class="h-10 w-10 text-gold/60" fill="currentColor" aria-hidden="true">
            <path d="M3 7h11.4l6.6 1.6-6.6 1.6H3V7Z" />
            <path d="M9.6 10.2h4.2l1.4 4.9H8.2l1.4-4.9Z" />
            <path d="M7 15.1h10l2.1 4.2H4.9L7 15.1Z" />
          </svg>
          <p class="mt-4 font-display text-lg tracking-[0.06em] text-parchment sm:text-xl">
            Les premières échoppes arrivent
          </p>
          <p class="mt-2 max-w-md text-sm leading-relaxed text-parchment-dim">
            Boucher, fromager, boulanger : les comptes de l’atelier sont encore
            en cours de vérification sur le wiki officiel. Le registre des
            champs, lui, est déjà ouvert.
          </p>
          <a href="/seneschal/champs/elevage-de-vaches" class="btn-ghost mt-6">
            Ouvrir l’élevage de vaches
          </a>
        </div>
      </section>
    )}

    {soon.length > 0 && (
      <section class="mt-12 sm:mt-16" aria-labelledby="autres-titre">
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
          <h2 id="autres-titre" class="label-caps">
            {isEchoppes ? "Les échoppes prévues" : "Les autres outils"}
          </h2>
          <p class="text-[0.625rem] uppercase tracking-[0.14em] text-parchment-dim/70">
            En préparation
          </p>
        </div>

        <div class="rule-gold mt-4 w-full opacity-70"></div>

        <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {soon.map((tool) => (
            <li class="tool-card card-dark texture-noise flex flex-col p-5">
              <div class="flex items-start justify-between gap-3">
                <h3 class="min-w-0 font-display text-base leading-snug tracking-[0.04em] text-parchment">
                  {tool.name}
                </h3>
                <span class="flex-none border border-parchment-dim/25 px-2 py-0.5 text-[0.5rem] font-semibold uppercase tracking-[0.14em] text-parchment-dim/80">
                  À venir
                </span>
              </div>
              <p class="mt-2 text-xs leading-relaxed text-parchment-dim">{tool.summary}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-gold/10 pt-6">
      <a href="/seneschal" class="link-arrow">
        <svg
          viewBox="0 0 24 24"
          class="h-3.5 w-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path d="M19 12H5M11 18l-6-6 6-6" />
        </svg>
        Tous les registres
      </a>
      <p class="text-[0.625rem] uppercase tracking-[0.14em] text-parchment-dim/70">
        Les calculs sont des estimations
      </p>
    </div>
  </div>
</Layout>

<style>
  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold);
    transition: color 0.15s ease;
  }
  .link-arrow:hover {
    color: var(--color-gold-light);
  }
  .link-arrow svg {
    transition: transform 0.15s ease;
  }
  .link-arrow:hover svg {
    transform: translateX(-3px);
  }

  .tool-card {
    transition: border-color 0.2s ease;
  }
  .tool-card:hover {
    border-color: color-mix(in oklab, var(--color-gold) 32%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .link-arrow,
    .link-arrow svg,
    .tool-card {
      transition: none;
    }
    .link-arrow:hover svg {
      transform: none;
    }
  }
</style>
