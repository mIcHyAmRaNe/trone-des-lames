---
import Layout from "../layouts/Layout.astro";

const { lang = 'fr' } = Astro.locals;

const COPY = {
    fr: {
        title: 'Le Trône des Lames  -  Les outils du royaume',
        description:
            'Les outils des joueurs de Renaissance Kingdoms : agenda des animations, calculateurs du Sénéchal, garde-robe et catalogue d’objets.',
        eyebrow: 'Renaissance Kingdoms · Outils de jeu',
        heroTitle: 'Du labour de vos terres',
        heroTitle2: 'aux intrigues de la Cour',
        heroLead:
            'Ne laissez rien au hasard dans votre ascension. Retrouvez ici tous les parchemins nécessaires aux sujets de Renaissance Kingdoms. Suivez les événements du royaume, optimisez la rentabilité de vos terres et échoppes, et composez vos plus belles tenues.',
        heroCta: 'Découvrir les outils',
        sigil: 'OUTILS',
        cards: [
            {
                eyebrow: 'La chronique',
                title: 'L’agenda des royaumes',
                description:
                    'Fêtes, marchés et cérémonies des royaumes, relus par l’organisation avant publication. Les prochaines dates, comté par comté.',
                cta: 'Ouvrir l’agenda',
                tags: ['Fêtes', 'Marchés', 'Cérémonies'],
                link: 'Proposer une animation',
            },
            {
                eyebrow: 'Les comptes',
                title: 'Le Sénéchal',
                description:
                    'Rendements, coûts et marges des champs et des échoppes, calculés sur les règles à jour du jeu.',
                cta: 'Ouvrir le Sénéchal',
                tags: [] as string[],
                link: 'Élevage de vaches',
            },
            {
                eyebrow: 'L’atelier',
                title: 'La garde-robe',
                description:
                    'Vêtements, armes et teintes : essayez-les sur votre personnage et exportez le rendu en PNG. Rien n’est enregistré dans le jeu.',
                cta: 'Ouvrir la garde-robe',
                tags: [] as string[],
                link: null,
            },
            {
                eyebrow: 'Le registre',
                title: 'Le catalogue',
                description:
                    'Tous les objets de garde-robe : emplacements, sexes et déclinaisons. La recherche fonctionne en français comme en anglais.',
                cta: 'Parcourir le catalogue',
                tags: [] as string[],
                link: 'Contribuer au catalogue',
            },
        ],
    },
    en: {
        title: 'The Throne of Blades  -  Tools of the realm',
        description:
            'Tools for Renaissance Kingdoms players: events calendar, Seneschal calculators, wardrobe and item catalogue.',
        eyebrow: 'Renaissance Kingdoms · Game tools',
        heroTitle: 'From the ploughing of your fields',
        heroTitle2: 'to the intrigues of the Court',
        heroLead:
            'Leave nothing to chance in your rise. Every parchment a subject of Renaissance Kingdoms needs is here. Follow the realm’s events, maximise the returns of your fields and workshops, and put together your finest outfits.',
        heroCta: 'Discover the tools',
        sigil: 'TOOLS',
        cards: [
            {
                eyebrow: 'The chronicle',
                title: 'The realm’s calendar',
                description:
                    'Festivals, markets and ceremonies across the kingdoms, reviewed by the organisers before publication. Upcoming dates, county by county.',
                cta: 'Open the calendar',
                tags: ['Festivals', 'Markets', 'Ceremonies'],
                link: 'Submit an event',
            },
            {
                eyebrow: 'The ledgers',
                title: 'The Seneschal',
                description:
                    'Yields, costs and margins for fields and workshops, calculated from the game’s current rules.',
                cta: 'Open the Seneschal',
                tags: [] as string[],
                link: 'Cattle farming',
            },
            {
                eyebrow: 'The workshop',
                title: 'The wardrobe',
                description:
                    'Clothes, weapons and dyes: try them on your character and export the result as a PNG. Nothing is saved in the game.',
                cta: 'Open the wardrobe',
                tags: [] as string[],
                link: null,
            },
            {
                eyebrow: 'The register',
                title: 'The catalogue',
                description:
                    'Every wardrobe item: slots, sexes and colour variants. Search works in French as well as English.',
                cta: 'Browse the catalogue',
                tags: [] as string[],
                link: 'Contribute to the catalogue',
            },
        ],
    },
} as const;

const copy = COPY[lang];

const hrefs = ['/agenda', '/seneschal', '/garde-robe', '/catalogue'];
const linkHrefs = [
    '/agenda#proposer',
    '/seneschal/champs/elevage-de-vaches',
    null,
    '/submit',
];
const shapes: { paths: string[]; primary?: boolean; featured?: boolean; span?: string }[] = [
    { featured: true, span: 'lg:col-span-3', paths: ['M4 6.5h16V20H4V6.5Z', 'M8 3.5v5M16 3.5v5M4 11h16'] },
    { span: 'lg:col-span-2', paths: ['M12 21V8', 'M12 12c-2.6 0-4.2-1.6-4.2-4.2 2.6 0 4.2 1.6 4.2 4.2Z', 'M12 12c2.6 0 4.2-1.6 4.2-4.2-2.6 0-4.2 1.6-4.2 4.2Z', 'M12 17.2c-2.6 0-4.2-1.6-4.2-4.2 2.6 0 4.2 1.6 4.2 4.2Z', 'M12 17.2c2.6 0 4.2-1.6-4.2-4.2 2.6 0-4.2 1.6-4.2 4.2Z'] },
    { span: 'lg:col-span-2', paths: ['M9 4l3 1.6L15 4l4.5 2.6-1.9 3.4-2.6-1.3V20H9V8.7L6.4 10 4.5 6.6 9 4Z'] },
    { span: 'lg:col-span-2', paths: ['M5 4.5A1.5 1.5 0 0 1 6.5 3H19v18H6.5A1.5 1.5 0 0 1 5 19.5v-15Z', 'M8.5 7.5h6M8.5 11.5h4'] },
];
const numerals = ['I', 'II', 'III', 'IV'];
const links = copy.cards.map((_, i) => {
    const href = linkHrefs[i];
    return href ? { href, label: copy.cards[i].link as string } : null;
});
const tools = copy.cards.map((card, i) => ({
    numeral: numerals[i],
    href: hrefs[i],
    eyebrow: card.eyebrow,
    title: card.title,
    description: card.description,
    cta: card.cta,
    tags: card.tags as unknown as string[],
    link: links[i],
    ...shapes[i],
}));
---

<Layout title={copy.title} description={copy.description}>
    <!-- HERO -->
    <section class="relative overflow-hidden border-b border-gold/15">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_55%_at_35%_0%,rgba(201,162,39,0.13),transparent_72%)]"></div>
        <div
            class="pointer-events-none absolute inset-0 opacity-[0.04]"
            aria-hidden="true"
            style="background-image: repeating-linear-gradient(90deg, var(--color-parchment) 0 1px, transparent 1px 92px)"
        >
        </div>

        <div class="container-tdl relative grid gap-10 py-14 sm:py-20 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-center lg:gap-16 lg:py-24">
            <div>
                <p class="label-caps reveal">{copy.eyebrow}</p>
                <h1 class="reveal mt-3 max-w-2xl text-balance font-display text-3xl font-bold tracking-[0.05em] text-parchment sm:text-4xl lg:text-[2.5rem]">
                    {copy.heroTitle}<br class="hidden xl:block" /> {copy.heroTitle2}
                </h1>
                <div class="rule-gold reveal my-5 w-28"></div>
                <p class="reveal max-w-lg text-balance leading-relaxed text-parchment-dim sm:text-base">
                    {copy.heroLead}
                </p>

                <div class="reveal mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                    <a href="#outils" class="btn-gold w-full justify-center sm:w-auto">
                        {copy.heroCta}
                    </a>
                </div>
            </div>

            <div class="relative hidden lg:block" aria-hidden="true">
                <div class="relative aspect-square max-w-lg">
                    <svg viewBox="0 0 200 200" class="absolute inset-0 h-full w-full text-gold/40" fill="none" stroke="currentColor">
                        <circle cx="100" cy="100" r="80" stroke-width="1" />
                        <circle cx="100" cy="100" r="72" stroke-width="0.4" stroke-dasharray="1 6" />
                        <circle cx="100" cy="100" r="54" stroke-width="0.6" />
                        <path d="M100 12l4.5 8-4.5 8-4.5-8 4.5-8z" fill="currentColor" stroke="none" />
                        <path d="M100 172l4.5 8-4.5 8-4.5-8 4.5-8z" fill="currentColor" stroke="none" opacity="0.6" />
                        <path d="M12 100l8-4.5 8 4.5-8 4.5-8-4.5z" fill="currentColor" stroke="none" opacity="0.6" />
                        <path d="M172 100l8-4.5 8 4.5-8 4.5-8-4.5z" fill="currentColor" stroke="none" opacity="0.6" />
                        <path d="M100 20v14M100 166v14M20 100h14M166 100h14" stroke-width="0.6" opacity="0.5" />
                    </svg>
                    <div class="relative text-center">
                        <p class="font-display text-[0.5rem] tracking-[0.32em] text-gold/60">{copy.sigil}</p>
                        <p class="mt-1.5 font-display text-2xl font-bold tracking-[0.1em] text-gold">
                            {new Date().getUTCFullYear().toString().slice(-2).padStart(2, '0')}
                        </p>
                        <p class="mt-2 text-[0.4375rem] uppercase leading-relaxed tracking-[0.22em] text-parchment-dim/55">
                            Renaissance
                            <br />
                            Kingdoms
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- TOOLS GRID -->
    <section id="outils" class="container-tdl scroll-mt-24 py-12 sm:py-16" aria-label="Les outils">
        <div class="tools-grid">
            {tools.map((tool) => (
                <article class="pillar card-dark texture-noise relative p-6 sm:p-8">
                    <span
                        class="pointer-events-none absolute right-5 top-4 font-display text-6xl font-black leading-none text-gold/10"
                        aria-hidden="true"
                    >
                        {tool.numeral}
                    </span>

                    <p class="label-caps mt-5">{tool.eyebrow}</p>
                    <h3 class="mt-2 font-display text-2xl tracking-[0.05em] text-parchment">
                        {tool.title}
                    </h3>
                    <p class="mt-3 max-w-md text-sm leading-relaxed text-parchment-dim">
                        {tool.description}
                    </p>

                    <div class="mt-10 flex flex-col gap-2 mt-auto">
                        <div class="h-px w-full bg-gradient-to-r from-transparent via-gold/50 to-transparent mt-4 mb-4" aria-hidden="true"></div>
                        <a href={tool.href} class="link-arrow flex items-center justify-center gap-2">
                            {tool.cta}
                            <svg
                                viewBox="0 0 24 24"
                                class="h-3.5 w-3.5"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                aria-hidden="true"
                            >
                                <path d="M5 12h14M13 6l6 6-6 6" />
                            </svg>
                        </a>
                    </div>
                </article>
            ))}
        </div>
    </section>
</Layout>

<style>
    .link-arrow {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--color-gold);
        transition: color 0.15s ease;
    }
    .link-arrow:hover {
        color: var(--color-gold-light);
    }
    .link-arrow svg {
        transition: transform 0.15s ease;
    }
    .link-arrow:hover svg {
        transform: translateX(3px);
    }

    .pillar {
        transition: border-color 0.2s ease;
        display: flex;
        flex-direction: column;
    }
    .pillar:hover {
        border-color: color-mix(in oklab, var(--color-gold) 38%, transparent);
    }

    .tools-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.25rem;
    }
    @media (max-width: 1024px) {
        .tools-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 640px) {
        .tools-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .link-arrow,
        .link-arrow svg,
        .pillar {
            transition: none;
        }
        .link-arrow:hover svg {
            transform: none;
        }
    }
</style>