---
import Layout from "../layouts/Layout.astro";

export const prerender = true;

type Tool = {
    numeral: string;
    href: string;
    eyebrow: string;
    title: string;
    description: string;
    cta: string;
    paths: string[];
    primary?: boolean;
    featured?: boolean;
    span?: string;
    tags?: string[];
    link?: { href: string; label: string };
};

const tools: Tool[] = [
    {
        numeral: 'I',
        href: '/tournoi',
        eyebrow: 'La lice',
        title: 'Le tournoi',
        description:
            'Seize combattants, quatre groupes, une couronne. Suivez les poules, les classements et la phase finale, duel après duel.',
        cta: 'Entrer dans le tournoi',
        primary: true,
        featured: true,
        span: 'sm:col-span-2 lg:col-span-3',
        tags: ['Poules', 'Phase finale', 'Palmarès'],
        paths: [
            'M3 8l4 2.6L12 5l5 5.6L21 8l-1.8 10.5H4.8L3 8Z',
            'M6 21h12',
        ],
        link: { href: '/tournoi?onglet=reglement', label: 'Lire le règlement' },
    },
    {
        numeral: 'II',
        href: '/agenda',
        eyebrow: 'La chronique',
        title: 'L’agenda des royaumes',
        description:
            'Fêtes, marchés et cérémonies des royaumes, relus par l’organisation avant publication. Les prochaines dates, comté par comté.',
        cta: 'Ouvrir l’agenda',
        featured: true,
        span: 'lg:col-span-3',
        tags: ['Fêtes', 'Marchés', 'Cérémonies'],
        paths: [
            'M4 6.5h16V20H4V6.5Z',
            'M8 3.5v5M16 3.5v5M4 11h16',
        ],
        link: { href: '/agenda#proposer', label: 'Proposer une animation' },
    },
    {
        numeral: 'III',
        href: '/seneschal',
        eyebrow: 'Les comptes',
        title: 'Le Sénéchal',
        description:
            'Rendements, coûts et marges des champs et des échoppes, calculés sur les règles à jour du jeu.',
        cta: 'Ouvrir le Sénéchal',
        span: 'lg:col-span-2',
        paths: [
            'M12 21V8',
            'M12 12c-2.6 0-4.2-1.6-4.2-4.2 2.6 0 4.2 1.6 4.2 4.2Z',
            'M12 12c2.6 0 4.2-1.6 4.2-4.2-2.6 0-4.2 1.6-4.2 4.2Z',
            'M12 17.2c-2.6 0-4.2-1.6-4.2-4.2 2.6 0 4.2 1.6 4.2 4.2Z',
            'M12 17.2c2.6 0 4.2-1.6 4.2-4.2-2.6 0-4.2 1.6-4.2 4.2Z',
        ],
        link: { href: '/seneschal/champs/elevage-de-vaches', label: 'Élevage de vaches' },
    },
    {
        numeral: 'IV',
        href: '/garde-robe',
        eyebrow: 'L’atelier',
        title: 'La garde-robe',
        description:
            'Vêtements, armes et teintes : essayez-les sur votre personnage et exportez le rendu en PNG. Rien n’est enregistré dans le jeu.',
        cta: 'Ouvrir la garde-robe',
        span: 'lg:col-span-2',
        paths: [
            'M9 4l3 1.6L15 4l4.5 2.6-1.9 3.4-2.6-1.3V20H9V8.7L6.4 10 4.5 6.6 9 4Z',
        ],
    },
    {
        numeral: 'V',
        href: '/catalogue',
        eyebrow: 'Le registre',
        title: 'Le catalogue',
        description:
            'Tous les objets de garde-robe : emplacements, sexes et déclinaisons. La recherche fonctionne en français comme en anglais.',
        cta: 'Parcourir le catalogue',
        span: 'lg:col-span-2',
        paths: [
            'M5 4.5A1.5 1.5 0 0 1 6.5 3H19v18H6.5A1.5 1.5 0 0 1 5 19.5v-15Z',
            'M8.5 7.5h6M8.5 11.5h4',
        ],
        link: { href: '/submit', label: 'Contribuer au catalogue' },
    },
];
---

<Layout
    title="Le Trône des Lames — Les outils du royaume"
    description="Les outils des joueurs de Renaissance Kingdoms : tournoi, agenda des animations, calculateurs du Sénéchal, garde-robe et catalogue d’objets."
>
    <!-- HERO -->
    <section class="relative overflow-hidden border-b border-gold/15">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_55%_at_35%_0%,rgba(201,162,39,0.13),transparent_72%)]"></div>
        <div
            class="pointer-events-none absolute inset-0 opacity-[0.04]"
            aria-hidden="true"
            style="background-image: repeating-linear-gradient(90deg, var(--color-parchment) 0 1px, transparent 1px 92px)"
        >
        </div>

        <div class="container-tdl relative grid gap-10 py-14 sm:py-20 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-center lg:gap-16 lg:py-24">
            <div>
                <p class="label-caps reveal">Renaissance Kingdoms · Outils de jeu</p>

                <h1 class="reveal mt-5 font-display text-[2.35rem] leading-[1.03] font-black tracking-[0.07em] text-parchment sm:text-5xl lg:text-6xl" style="animation-delay:0.05s">
                    LE TRÔNE
                    <br />
                    <span class="bg-gradient-to-b from-gold-light via-gold to-gold-dim bg-clip-text text-transparent">
                        DES LAMES
                    </span>
                </h1>

                <div class="rule-gold reveal my-6 w-32" style="animation-delay:0.1s"></div>

                <p class="reveal max-w-lg text-balance leading-relaxed text-parchment-dim" style="animation-delay:0.15s">
                    Combattre en lice, suivre les fêtes des royaumes, calculer
                    la marge d’un champ, essayer une tenue : les outils des
                    joueurs de Renaissance Kingdoms, réunis au même endroit.
                </p>

                <div class="reveal mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap" style="animation-delay:0.2s">
                    <a href="/tournoi" class="btn-gold w-full justify-center sm:w-auto">
                        Entrer dans le tournoi
                    </a>
                    <a href="/agenda" class="btn-ghost w-full justify-center sm:w-auto">
                        Ouvrir l’agenda
                    </a>
                </div>
            </div>

            <div
                class="reveal relative mx-auto hidden w-full max-w-[19rem] sm:block lg:max-w-[22rem]"
                style="animation-delay:0.14s"
                aria-hidden="true"
            >
                <svg viewBox="0 0 320 320" class="h-auto w-full text-gold" fill="none" aria-hidden="true">
                    <circle cx="160" cy="160" r="152" stroke="currentColor" stroke-opacity="0.14" />
                    <circle
                        cx="160"
                        cy="160"
                        r="126"
                        stroke="currentColor"
                        stroke-opacity="0.3"
                        stroke-dasharray="1 8"
                        stroke-linecap="round"
                        class="sigil-ring"
                    />
                    <circle cx="160" cy="160" r="98" stroke="currentColor" stroke-opacity="0.2" />
                    <circle cx="160" cy="160" r="88" stroke="currentColor" stroke-opacity="0.35" stroke-width="0.75" />
                    <path
                        d="M160 8v22M160 290v22M8 160h22M290 160h22"
                        stroke="currentColor"
                        stroke-opacity="0.4"
                        stroke-width="1.5"
                    />
                    <path
                        d="M160 58l10 82 82 10-82 10-10 82-10-82-82-10 82-10 10-82Z"
                        fill="currentColor"
                        fill-opacity="0.06"
                    />
                    <text
                        x="160"
                        y="158"
                        text-anchor="middle"
                        dominant-baseline="central"
                        font-family="Cinzel, serif"
                        font-size="84"
                        font-weight="700"
                        letter-spacing="4"
                        fill="currentColor"
                        fill-opacity="0.9">V</text>
                    <text
                        x="160"
                        y="224"
                        text-anchor="middle"
                        font-family="Inter, sans-serif"
                        font-size="9"
                        letter-spacing="4"
                        fill="currentColor"
                        fill-opacity="0.55">OUTILS</text>
                </svg>
            </div>
        </div>
    </section>

    <!-- TOOLS -->
    <section class="container-tdl py-16 sm:py-20" aria-labelledby="outils-titre">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <p class="label-caps">Les outils</p>
                <h2 id="outils-titre" class="mt-3 font-display text-3xl leading-tight tracking-[0.04em] text-parchment sm:text-4xl">
                    Cinq outils,
                    <br class="hidden sm:block" /> un même royaume
                </h2>
            </div>
            <p class="max-w-sm text-sm leading-relaxed text-parchment-dim lg:text-right">
                Chaque outil a sa page. Règlement, propositions d’animations et
                contributions au catalogue s’y trouvent aussi.
            </p>
        </div>

        <div class="rule-gold mt-8 w-full opacity-60"></div>

        <div class="mt-8 grid items-stretch gap-5 sm:grid-cols-2 lg:grid-cols-6">
            {tools.map((tool, i) => (
                <article
                    class:list={[
                        'card-dark texture-noise group relative flex flex-col p-6 sm:p-7',
                        tool.span,
                    ]}
                >
                    {tool.featured && (
                        <span
                            class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold/50 to-transparent"
                            aria-hidden="true"
                        >
                        </span>
                    )}

                    <span
                        class="pointer-events-none absolute right-5 top-4 font-display text-5xl leading-none font-black text-gold/10 transition-colors group-hover:text-gold/20 sm:text-6xl"
                        aria-hidden="true"
                    >
                        {tool.numeral}
                    </span>

                    <div class="reveal" style={`animation-delay:${0.05 + i * 0.05}s`}>
                        <div class="flex items-center gap-3">
                            <span class="flex h-11 w-11 flex-none items-center justify-center border border-gold/25 bg-ink/30 text-gold">
                                <svg
                                    viewBox="0 0 24 24"
                                    class="h-5 w-5"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    {tool.paths.map((d) => <path d={d} />)}
                                </svg>
                            </span>
                            <p class="label-caps">{tool.eyebrow}</p>
                        </div>

                        <h3
                            class:list={[
                                'mt-5 font-display tracking-[0.05em] text-parchment transition-colors group-hover:text-gold-light',
                                tool.featured ? 'text-2xl' : 'text-xl',
                            ]}
                        >
                            {tool.title}
                        </h3>

                        <p class="mt-3 text-sm leading-relaxed text-parchment-dim">
                            {tool.description}
                        </p>

                        {tool.tags && (
                            <p class="mt-4 text-[0.625rem] uppercase tracking-[0.16em] text-parchment-dim/80">
                                {tool.tags.map((tag, index) => (
                                    <span class="whitespace-nowrap">
                                        {index > 0 && <span class="px-1.5 text-gold/40" aria-hidden="true">◆</span>}
                                        {tag}
                                    </span>
                                ))}
                            </p>
                        )}
                    </div>

                    <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 pt-6">
                        <a
                            href={tool.href}
                            class:list={[
                                tool.primary ? 'btn-gold' : 'btn-ghost',
                                'card-link w-full justify-center sm:w-auto',
                            ]}
                        >
                            {tool.cta}
                        </a>

                        {tool.link && (
                            <a href={tool.link.href} class="link-arrow relative z-10">
                                {tool.link.label}
                                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M5 12h14M13 6l6 6-6 6" />
                                </svg>
                            </a>
                        )}
                    </div>
                </article>
            ))}
        </div>
    </section>
</Layout>

<style>
    .link-arrow {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--color-gold);
        transition: color 0.15s ease;
    }
    .link-arrow:hover {
        color: var(--color-gold-light);
    }
    .link-arrow svg {
        transition: transform 0.15s ease;
    }
    .link-arrow:hover svg {
        transform: translateX(3px);
    }

    /* Toute la carte ouvre son outil : l'ombre du bouton recouvre la carte. */
    .card-link::after {
        content: "";
        position: absolute;
        inset: 0;
    }

    @media (prefers-reduced-motion: no-preference) {
        .sigil-ring {
            transform-origin: 160px 160px;
            animation: sigil-spin 90s linear infinite;
        }
    }
    @keyframes sigil-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .link-arrow,
        .link-arrow svg {
            transition: none;
        }
        .link-arrow:hover svg {
            transform: none;
        }
    }
</style>
