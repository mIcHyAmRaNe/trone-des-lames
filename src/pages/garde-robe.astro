---
import Layout from "../layouts/Layout.astro";
import Wardrobe from "../components/garde-robe/Wardrobe.tsx";

// Coquille statique : l'îlot React s'hydrate côté client.
export const prerender = false;

const { lang = 'fr' } = Astro.locals;
const copy = {
    fr: {
        title: 'Garde-robe  -  Le Trône des Lames',
        description: 'Essayez les vêtements, armes et teintes de Renaissance Kingdoms sur un personnage : accès direct avec un personnage par défaut, personnalisation du corps et du visage, chargement d\'une fiche par nom, tenues conservées et export PNG.',
        eyebrow: 'Renaissance Kingdoms · Essayage',
        heading: 'La Garde-robe',
        lead: 'La garde-robe s\'ouvre sur un personnage par défaut : le portrait est là tout de suite, sans identifiant à saisir. Réglez le sexe et les traits du visage, essayez vêtements, armes et teintes, puis chargez la fiche d\'un personnage par son nom. L\'essayage reste dans votre navigateur  -  aucune modification n\'est enregistrée dans le jeu.',
    },
    en: {
        title: 'Wardrobe  -  The Throne of Blades',
        description: 'Try Renaissance Kingdoms clothes, weapons and dyes on a character: instant default character, body and face customisation, loading a sheet by name, saved outfits and PNG export.',
        eyebrow: 'Renaissance Kingdoms · Fitting room',
        heading: 'The Wardrobe',
        lead: 'The wardrobe opens on a default character: the portrait is there straight away, with no login. Set the sex and facial features, try on clothes, weapons and dyes, then load a character\'s sheet by name. Everything stays in your browser  -  nothing is saved in the game.',
    },
}[lang];
---

<Layout title={copy.title} description={copy.description}>
    <section class="relative overflow-hidden border-b border-gold/15 bg-ink-2/40">
        <div
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_55%_at_35%_0%,rgba(201,162,39,0.13),transparent_72%)]"
            aria-hidden="true"
        >
        </div>

        <div class="container-tdl relative py-14">
            <p class="label-caps">{copy.eyebrow}</p>
            <h1 class="mt-3 font-display text-3xl font-bold tracking-[0.06em] text-parchment sm:text-5xl">
                {copy.heading}
            </h1>
            <div class="rule-gold my-5 w-28"></div>
            <p class="max-w-lg text-sm leading-relaxed text-parchment-dim">
                {copy.lead}
            </p>
        </div>
    </section>

    <div class="container-tdl py-8 sm:py-10">
        <script is:inline src="/vendor/midas.js"></script>
        <Wardrobe client:load lang={lang} />
    </div>
</Layout>
