---
import Layout from '../layouts/Layout.astro';
import SubmitForm from '../components/SubmitForm';

const { lang = 'fr' } = Astro.locals;
const copy = {
  fr: {
    title: 'Soumettre un objet  -  Catalogue',
    description: 'Proposez un nouvel objet pour le catalogue de la garde-robe.',
    eyebrow: 'Contributions',
    heading: 'Soumettre un objet',
    lead: 'Proposez un objet manquant ou complétez une fiche. Indiquez votre pseudo en jeu : il est vérifié, aucun mot de passe n’est demandé. Votre proposition sera examinée par un administrateur avant publication.',
  },
  en: {
    title: 'Submit an item  -  Catalogue',
    description: 'Suggest a new item for the wardrobe catalogue.',
    eyebrow: 'Contributions',
    heading: 'Submit an item',
    lead: 'Suggest a missing item or fill in a sheet. Enter your in-game name: it is checked, and no password is asked for. An administrator reviews your proposal before publication.',
  },
}[lang];
---

<Layout title={copy.title} description={copy.description}>
  <main class="min-h-screen">
    <div class="mx-auto w-full max-w-2xl px-4 py-10 sm:py-14">
      <p class="label-caps reveal">{copy.eyebrow}</p>
      <h1 class="reveal mt-2 font-display text-3xl font-bold tracking-[0.05em] text-parchment">{copy.heading}</h1>
      <div class="rule-gold reveal my-4 w-20"></div>
      <p class="reveal text-sm leading-relaxed text-parchment-dim">
        {copy.lead}
      </p>

      <div class="mt-6">
        <SubmitForm client:load lang={lang} />
      </div>
    </div>
  </main>
</Layout>