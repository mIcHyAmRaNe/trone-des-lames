---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import { common, locale, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const { lang = 'fr' } = Astro.locals as { lang?: Lang };
const c = (key: Parameters<typeof common>[1]) => common(lang, key);

const {
  title = lang === 'fr'
    ? 'Le Trône des Lames  -  Tournoi Renaissance Kingdoms'
    : 'The Throne of Blades  -  Renaissance Kingdoms tournament',
  description = lang === 'fr'
    ? 'Seize combattants, quatre groupes, une seule couronne. Suivez le tournoi Le Trône des Lames : poules, classements et phase finale.'
    : 'Sixteen fighters, four groups, one crown. Follow the Throne of Blades tournament: groups, standings and the knockout stage.',
} = Astro.props;

const path = Astro.url.pathname;

// Le cookie est écrit par le toggle : il permet de rendre le bon thème dès le
// HTML (avant JS, avant le CSS), donc plus de page qui démarre en sombre.
let cookieTheme: string | undefined;
if (!Astro.isPrerendered) {
  try {
    cookieTheme = Astro.cookies.get('tdl-theme')?.value;
  } catch {}
}
const theme = cookieTheme === 'light' || cookieTheme === 'dark' ? cookieTheme : 'dark';
const links = [
  { href: '/', label: c('home') },
  { href: '/agenda', label: c('agenda') },
  { href: '/seneschal', label: c('seneschal') },
  { href: '/garde-robe', label: c('wardrobe') },
  { href: '/catalogue', label: c('catalogue') },
];
---

<!doctype html>
<html lang={locale(lang)} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" id="tdl-theme-color" content={theme === 'light' ? '#e8dcc2' : '#0d0b0a'} />
    <script is:inline>
      // Pose le thème avant le premier rendu : évite tout flash.
      // localStorage peut être bloqué (navigation privée, iframe) : un cookie
      // sert de secours, sinon le choix ne survivrait pas au changement de page.
      (() => {
        const html = document.documentElement;
        let theme = html.dataset.theme === 'light' ? 'light' : 'dark';
        let explicit = false;
        try {
          const stored = localStorage.getItem('tdl-theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
            explicit = true;
          }
        } catch {}
        if (!explicit) {
          try {
            const m = document.cookie.match(/(?:^|;\s*)tdl-theme=(light|dark)/);
            if (m) theme = m[1];
          } catch {}
        }
        html.dataset.theme = theme;
        const meta = document.getElementById('tdl-theme-color');
        if (meta) meta.setAttribute('content', theme === 'light' ? '#e8dcc2' : '#0d0b0a');
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="flex min-h-screen flex-col">
    <div class="border-b border-gold/20 bg-gold/[0.07]">
      <p class="container-tdl flex flex-wrap items-center justify-center gap-x-2 py-1.5 text-center text-[0.6875rem] leading-snug text-parchment-dim">
        <span class="flex-none border border-gold/40 px-1.5 py-0.5 text-[0.5625rem] font-bold uppercase tracking-[0.16em] text-gold-light">
          {c('alphaTag')}
        </span>
        {c('alpha')}
      </p>
    </div>

    <header class="sticky top-0 z-50 border-b border-gold/25 bg-ink/85 backdrop-blur-md">
      <div class="container-tdl flex h-16 flex-wrap content-center items-center justify-between gap-x-2 gap-y-0 sm:gap-x-3 lg:flex-nowrap">
        <a href="/" class="group flex min-w-0 items-center gap-2.5" aria-label={c('homeAria')}>
          <svg viewBox="0 0 24 24" class="h-6 w-6 flex-none text-gold transition-transform group-hover:rotate-6" fill="currentColor" aria-hidden="true">
            <path d="M2 7l4 3 6-7 6 7 4-3-2 12H4L2 7zm4.4 10h11.2l1-6.2L16 12 12 5.8 8 12 5.4 10.8l1 6.2zM6 20h12v2H6v-2z"/>
          </svg>
          <span class="truncate font-display text-xs font-bold tracking-[0.16em] text-parchment sm:text-sm sm:tracking-[0.18em]">
            <span class="hidden sm:inline">{c('site')}</span>
          </span>
        </a>

        <div class="order-2 flex items-center gap-1.5 lg:order-3">
          <LanguageToggle lang={lang} />
          <ThemeToggle class="h-8 w-8 lg:h-9 lg:w-9" />
        </div>

        <nav aria-label={c('mainNav')} class="order-3 ml-auto w-full flex-none lg:order-2 lg:w-auto">
          <ul class="flex items-center justify-between gap-0 sm:justify-center sm:gap-1 lg:justify-end lg:gap-2">
            {links.map((l) => {
              const active = l.href === '/' ? path === '/' : path.startsWith(l.href);
              return (
                <li class:list={[l.href === '/' && 'hidden sm:block']}>
                  <a
                    href={l.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'block px-1 py-2 text-[0.5625rem] font-semibold uppercase tracking-[0.08em] transition-colors sm:px-2 sm:text-[0.625rem] sm:tracking-[0.12em] lg:px-3 lg:text-[0.6875rem] lg:tracking-[0.16em]',
                      active ? 'text-gold' : 'text-parchment-dim hover:text-parchment',
                    ]}
                  >
                    {l.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 border-t border-gold/20 bg-ink-2">
      <div class="container-tdl flex flex-col items-center gap-3 py-10 text-center">
        <svg viewBox="0 0 24 24" class="h-7 w-7 text-gold/70" fill="currentColor" aria-hidden="true">
          <path d="M2 7l4 3 6-7 6 7 4-3-2 12H4L2 7zm4.4 10h11.2l1-6.2L16 12 12 5.8 8 12 5.4 10.8l1 6.2zM6 20h12v2H6v-2z"/>
        </svg>
        <p class="font-display text-xs tracking-[0.24em] text-gold">{c('site')}</p>
        <p class="max-w-md text-xs leading-relaxed text-parchment-dim">
          {c('footerTagline')}
        </p>

        <div class="rule-gold my-3 w-24" aria-hidden="true"></div>

        <div class="max-w-xl space-y-1.5 text-xs leading-relaxed text-parchment-dim">
          <p>{c('footerUnofficial')}</p>
          <p>{c('footerPassword')}</p>
          <p>{c('footerGuides')}</p>
          <p class="pt-1">
            <a
              href="/confidentialite"
              class="text-gold/90 underline decoration-gold/30 underline-offset-4 transition-colors hover:text-gold hover:decoration-gold"
            >
              {c('privacy')}
            </a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>