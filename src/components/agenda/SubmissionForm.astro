---
import type { Lang } from '../../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'fr' } = Astro.props;

const copy = {
  fr: {
    eyebrow: 'Proposer',
    heading: 'Inscrire une animation au registre',
    lead: 'Fête, tournoi, marché, cérémonie : annoncez votre animation pour qu’elle figure dans la chronique des royaumes. Les dates sont incluses dans la durée.',
    note: 'Toute proposition est relue par l’organisation. L’animation n’apparaît dans l’agenda qu’après validation.',
    steps: [
      { n: 'I', t: 'Vous inscrivez l’animation', d: 'Nom, ville, comté, dates et lien du forum.' },
      { n: 'II', t: 'L’organisation vérifie', d: 'Les dates et le sujet du forum sont contrôlés.' },
      { n: 'III', t: 'L’animation rejoint la chronique', d: 'Elle apparaît dans l’agenda à sa date.' },
    ],
    title: 'Nom de l’animation',
    titleHint: '3 à 100 caractères.',
    titlePlaceholder: 'Foire de la Saint-Martin',
    rkName: 'Votre nom sur RK',
    rkNameHint: 'Le nom du joueur qui organise.',
    city: 'Ville',
    cityHint: 'Ville où se tient l’animation.',
    county: 'Comté',
    countyHint: 'Comté ou duché de la ville.',
    forum: 'Lien du forum',
    forumHint: 'Sujet officiel sur le forum RK.',
    start: 'Début',
    end: 'Fin',
    datesHint: 'Dates incluses, un an maximum.',
    website: 'Site internet',
    submit: 'Envoyer la proposition',
    sending: 'Envoi en cours…',
    required: 'Champs obligatoires',
    successEyebrow: 'Proposition transmise',
    successHeading: 'L’animation est entre les mains de l’organisation',
    successBody: 'Merci. Votre proposition sera relue avant publication : elle apparaîtra dans la chronique une fois validée, à la date indiquée.',
    again: 'Proposer une autre animation',
    errorGeneric: 'La proposition n’a pas pu être envoyée. Vérifiez les informations et réessayez.',
    errorRate: 'Trop de propositions envoyées coup sur coup. Réessayez dans quelques minutes.',
    errorInvalid: 'Certaines informations sont incomplètes ou invalides. Vérifiez les champs et les dates.',
    errorNetwork: 'Connexion impossible. Vérifiez votre réseau, puis réessayez.',
    dateOrder: 'La date de fin doit suivre la date de début.',
    dateMax: 'Une animation ne peut pas durer plus d’un an.',
  },
  en: {
    eyebrow: 'Submit',
    heading: 'Enter an event in the register',
    lead: 'Festival, tournament, market, ceremony: announce your event so it appears in the realm’s chronicle. Dates are inclusive.',
    note: 'Every submission is reviewed by the organisers. An event only appears in the calendar once approved.',
    steps: [
      { n: 'I', t: 'You enter the event', d: 'Name, town, county, dates and forum link.' },
      { n: 'II', t: 'The organisers check', d: 'The dates and the forum thread are verified.' },
      { n: 'III', t: 'The event joins the chronicle', d: 'It appears in the calendar on its date.' },
    ],
    title: 'Event name',
    titleHint: '3 to 100 characters.',
    titlePlaceholder: 'St Martin’s Fair',
    rkName: 'Your RK name',
    rkNameHint: 'The name of the player organising.',
    city: 'Town',
    cityHint: 'Town where the event takes place.',
    county: 'County',
    countyHint: 'County or duchy of the town.',
    forum: 'Forum link',
    forumHint: 'Official thread on the RK forum.',
    start: 'Start',
    end: 'End',
    datesHint: 'Dates inclusive, one year maximum.',
    website: 'Website',
    submit: 'Send submission',
    sending: 'Sending…',
    required: 'Required fields',
    successEyebrow: 'Submission sent',
    successHeading: 'The event is now with the organisers',
    successBody: 'Thank you. Your submission will be reviewed before publication: it will appear in the chronicle once approved, on the date given.',
    again: 'Submit another event',
    errorGeneric: 'The submission could not be sent. Check the details and try again.',
    errorRate: 'Too many submissions sent in quick succession. Try again in a few minutes.',
    errorInvalid: 'Some details are incomplete or invalid. Check the fields and dates.',
    errorNetwork: 'Connection failed. Check your network, then try again.',
    dateOrder: 'The end date must be on or after the start date.',
    dateMax: 'An event cannot last longer than one year.',
  },
}[lang];
---

<section id="proposer" class="mt-20 scroll-mt-24" aria-labelledby="proposer-titre">
  <div class="card-dark texture-noise relative overflow-hidden">
    <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold/70 to-transparent" aria-hidden="true"></span>

    <div class="grid gap-10 px-6 py-9 sm:px-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14 lg:py-12">
      <div>
        <p class="label-caps">{copy.eyebrow}</p>
        <h2 id="proposer-titre" class="mt-2 font-display text-2xl leading-snug tracking-[0.05em] text-parchment sm:text-3xl">
          {copy.heading}
        </h2>
        <div class="rule-gold my-5 w-20"></div>
        <p class="max-w-md text-sm leading-relaxed text-parchment-dim">
          {copy.lead}
        </p>

        <div class="mt-6 flex gap-3 border-l-2 border-gold/50 pl-4">
          <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 flex-none text-gold" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M12 3l7 3v6c0 4.2-3 7.4-7 9-4-1.6-7-4.8-7-9V6l7-3z" />
            <path d="M9 12l2 2 4-4" />
          </svg>
          <p class="text-xs leading-relaxed text-parchment-dim">
            {copy.note}
          </p>
        </div>

        <ol class="mt-8 hidden space-y-4 sm:block">
          {copy.steps.map((step) => (
            <li class="flex gap-3">
              <span class="step-num">{step.n}</span>
              <span class="min-w-0">
                <span class="block text-xs font-semibold text-parchment">{step.t}</span>
                <span class="mt-0.5 block text-xs leading-relaxed text-parchment-dim/80">{step.d}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>

      <div>
        <form
          data-agenda-form
          class="grid gap-5 sm:grid-cols-2"
          data-msg-sending={copy.sending}
          data-msg-submit={copy.submit}
          data-msg-error-generic={copy.errorGeneric}
          data-msg-error-rate={copy.errorRate}
          data-msg-error-invalid={copy.errorInvalid}
          data-msg-error-network={copy.errorNetwork}
          data-msg-date-order={copy.dateOrder}
          data-msg-date-max={copy.dateMax}
        >
          <div class="sm:col-span-2">
            <label for="ev-title" class="field-label">
              {copy.title} <span class="text-gold" aria-hidden="true">*</span>
            </label>
            <input
              id="ev-title"
              name="title"
              type="text"
              required
              minlength="3"
              maxlength="100"
              autocomplete="off"
              placeholder={copy.titlePlaceholder}
              class="field"
              aria-describedby="ev-title-hint"
            />
            <p id="ev-title-hint" class="field-hint">{copy.titleHint}</p>
          </div>

          <div>
            <label for="ev-rk" class="field-label">
              {copy.rkName} <span class="text-gold" aria-hidden="true">*</span>
            </label>
            <input
              id="ev-rk"
              name="rkName"
              type="text"
              required
              minlength="2"
              maxlength="60"
              autocomplete="nickname"
              class="field"
              aria-describedby="ev-rk-hint"
            />
            <p id="ev-rk-hint" class="field-hint">{copy.rkNameHint}</p>
          </div>

          <div>
            <label for="ev-city" class="field-label">
              {copy.city} <span class="text-gold" aria-hidden="true">*</span>
            </label>
            <input
              id="ev-city"
              name="city"
              type="text"
              required
              minlength="2"
              maxlength="60"
              autocomplete="off"
              class="field"
              aria-describedby="ev-city-hint"
            />
            <p id="ev-city-hint" class="field-hint">{copy.cityHint}</p>
          </div>

          <div>
            <label for="ev-county" class="field-label">
              {copy.county} <span class="text-gold" aria-hidden="true">*</span>
            </label>
            <input
              id="ev-county"
              name="county"
              type="text"
              required
              minlength="2"
              maxlength="60"
              autocomplete="off"
              class="field"
              aria-describedby="ev-county-hint"
            />
            <p id="ev-county-hint" class="field-hint">{copy.countyHint}</p>
          </div>

          <div>
            <label for="ev-url" class="field-label">
              {copy.forum} <span class="text-gold" aria-hidden="true">*</span>
            </label>
            <input
              id="ev-url"
              name="forumUrl"
              type="url"
              required
              maxlength="500"
              inputmode="url"
              autocomplete="url"
              placeholder="https://…"
              class="field"
              aria-describedby="ev-url-hint"
            />
            <p id="ev-url-hint" class="field-hint">{copy.forumHint}</p>
          </div>

          <div class="sm:col-span-2">
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="ev-start" class="field-label">
                  {copy.start} <span class="text-gold" aria-hidden="true">*</span>
                </label>
                <input
                  id="ev-start"
                  name="startsOn"
                  type="date"
                  required
                  class="field [color-scheme:dark]"
                  aria-describedby="ev-dates-hint"
                />
              </div>
              <div>
                <label for="ev-end" class="field-label">
                  {copy.end} <span class="text-gold" aria-hidden="true">*</span>
                </label>
                <input
                  id="ev-end"
                  name="endsOn"
                  type="date"
                  required
                  class="field [color-scheme:dark]"
                  aria-describedby="ev-dates-hint"
                />
              </div>
            </div>
            <p id="ev-dates-hint" class="field-hint">{copy.datesHint}</p>
          </div>

          <!-- Honeypot: invisible to humans, must stay empty. -->
          <div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
            <label for="ev-website">{copy.website}</label>
            <input id="ev-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="sm:col-span-2">
            <p data-form-status role="alert" hidden class="form-status"></p>

            <div class="mt-1 flex flex-wrap items-center gap-4">
              <button type="submit" class="btn-gold" data-submit>
                <span data-submit-label>{copy.submit}</span>
              </button>
              <p class="text-[0.625rem] uppercase tracking-[0.14em] text-parchment-dim/60">
                <span class="text-gold" aria-hidden="true">*</span> {copy.required}
              </p>
            </div>
          </div>
        </form>

        <div data-form-success hidden tabindex="-1" class="outline-none">
          <div class="flex items-center gap-3">
            <span class="seal-check">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M5 12.5l4.5 4.5L19 7.5" />
              </svg>
            </span>
            <p class="label-caps">{copy.successEyebrow}</p>
          </div>
          <h3 class="mt-4 font-display text-xl tracking-[0.04em] text-parchment">
            {copy.successHeading}
          </h3>
          <div class="rule-gold my-4 w-16"></div>
          <p class="max-w-lg text-sm leading-relaxed text-parchment-dim">
            {copy.successBody}
          </p>
          <button type="button" class="btn-ghost mt-6" data-form-again>
            {copy.again}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .field-label {
    display: block;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-gold) 80%, var(--color-parchment-dim));
  }
  .field {
    display: block;
    width: 100%;
    margin-top: 0.4rem;
    padding: 0.6rem 0.7rem;
    background: color-mix(in oklab, var(--color-ink) 55%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-gold) 22%, transparent);
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-parchment);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .field::placeholder {
    color: color-mix(in oklab, var(--color-parchment-dim) 55%, transparent);
  }
  .field:hover {
    border-color: color-mix(in oklab, var(--color-gold) 38%, transparent);
  }
  .field:focus-visible {
    border-color: var(--color-gold);
    background: color-mix(in oklab, var(--color-ink) 80%, transparent);
  }
  .field-hint {
    margin-top: 0.3rem;
    font-size: 0.6875rem;
    line-height: 1.5;
    color: color-mix(in oklab, var(--color-parchment-dim) 75%, transparent);
  }
  .form-status {
    margin-bottom: 1rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid color-mix(in oklab, var(--color-blood) 65%, transparent);
    background: color-mix(in oklab, var(--color-blood) 12%, transparent);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-parchment);
  }
  .seal-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid color-mix(in oklab, var(--color-gold) 55%, transparent);
    border-radius: 999px;
    color: var(--color-gold-light);
  }
  .step-num {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid color-mix(in oklab, var(--color-gold) 28%, transparent);
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--color-gold);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-agenda-form]');
  const success = document.querySelector<HTMLElement>('[data-form-success]');
  const againButton = document.querySelector<HTMLButtonElement>('[data-form-again]');

  if (form && success) {
    const msg = {
      sending: form.dataset.msgSending ?? '',
      submit: form.dataset.msgSubmit ?? '',
      errorGeneric: form.dataset.msgErrorGeneric ?? '',
      errorRate: form.dataset.msgErrorRate ?? '',
      errorInvalid: form.dataset.msgErrorInvalid ?? '',
      errorNetwork: form.dataset.msgErrorNetwork ?? '',
      dateOrder: form.dataset.msgDateOrder ?? '',
      dateMax: form.dataset.msgDateMax ?? '',
    };
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const startsOn = form.elements.namedItem('startsOn') as HTMLInputElement | null;
    const endsOn = form.elements.namedItem('endsOn') as HTMLInputElement | null;

    const showStatus = (message: string) => {
      if (!status) return;
      status.textContent = message;
      status.hidden = false;
    };

    const validateDates = () => {
      if (!startsOn || !endsOn) return;
      endsOn.min = startsOn.value;
      if (!startsOn.value || !endsOn.value) {
        endsOn.setCustomValidity('');
        return;
      }
      const days =
        (Date.parse(`${endsOn.value}T00:00:00Z`) - Date.parse(`${startsOn.value}T00:00:00Z`)) /
          86_400_000 +
        1;
      if (endsOn.value < startsOn.value) {
        endsOn.setCustomValidity(msg.dateOrder);
      } else if (days > 366) {
        endsOn.setCustomValidity(msg.dateMax);
      } else {
        endsOn.setCustomValidity('');
      }
    };

    startsOn?.addEventListener('change', validateDates);
    endsOn?.addEventListener('change', validateDates);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      validateDates();
      if (!form.reportValidity()) return;

      if (status) status.hidden = true;
      if (submit) submit.disabled = true;
      if (submitLabel) submitLabel.textContent = msg.sending;

      const payload = Object.fromEntries(new FormData(form));

      try {
        const response = await fetch('/api/events', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (response.ok) {
          form.reset();
          if (endsOn) endsOn.min = '';
          if (endsOn) endsOn.setCustomValidity('');
          form.hidden = true;
          success.hidden = false;
          success.focus();
          return;
        }

        let message = msg.errorGeneric;

        if (response.status === 429) {
          message = msg.errorRate;
        } else if (response.status === 400) {
          const body = (await response.json().catch(() => null)) as
            | { error?: unknown; message?: unknown }
            | null;
          const detail =
            typeof body?.error === 'string'
              ? body.error
              : typeof body?.message === 'string'
                ? body.message
                : '';
          message = detail || msg.errorInvalid;
        }

        showStatus(message);
      } catch {
        showStatus(msg.errorNetwork);
      } finally {
        if (submit) submit.disabled = false;
        if (submitLabel) submitLabel.textContent = msg.submit;
      }
    });

    againButton?.addEventListener('click', () => {
      success.hidden = true;
      form.hidden = false;
      form.reset();
      if (status) status.hidden = true;
      const firstField = form.querySelector<HTMLInputElement>('input[name="title"]');
      firstField?.focus();
    });
  }
</script>
