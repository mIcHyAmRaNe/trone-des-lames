---
import type { TournamentState } from '../lib/state';
import MatchNode from './MatchNode.astro';

interface Props {
  state: TournamentState;
}

const { state } = Astro.props;

const qf = state.matches.filter((m) => m.phase === 'qf').sort((a, b) => a.slot - b.slot);
const sf = state.matches.filter((m) => m.phase === 'sf').sort((a, b) => a.slot - b.slot);
const fin = state.matches.find((m) => m.phase === 'final');

const hasBracket = qf.length > 0;

/**
 * Visual order matters: SF1 is fed by QF1+QF3 and SF2 by QF2+QF4, so the pairs
 * must be adjacent on screen. That gives the column order below.
 *
 * Four equal rows, centres at 12.5 / 37.5 / 62.5 / 87.5 %:
 *   row 1 = QF1 -> 12.5     SF1 between rows 1-2 -> 25
 *   row 2 = QF3 -> 37.5     SF2 between rows 3-4 -> 75
 *   row 3 = QF2 -> 62.5     Final centred on all four -> 50
 *   row 4 = QF4 -> 87.5
 */
const qfOrder = [
  { slot: 1, y: 12.5 },
  { slot: 3, y: 37.5 },
  { slot: 2, y: 62.5 },
  { slot: 4, y: 87.5 },
];
const sfOrder = [
  { slot: 1, y: 25 },
  { slot: 2, y: 75 },
];
const FINAL_Y = 50;

const gapOne = [
  { from: 12.5, to: 37.5, out: 25 },
  { from: 62.5, to: 87.5, out: 75 },
];
const gapTwo = [{ from: 25, to: 75, out: FINAL_Y }];

const qfBySlot = (slot: number) => qf.find((m) => m.slot === slot);
const sfBySlot = (slot: number) => sf.find((m) => m.slot === slot);
---

{!hasBracket ? (
  <div class="card-dark texture-noise flex flex-col items-center gap-3 px-6 py-16 text-center">
    <svg viewBox="0 0 24 24" class="h-10 w-10 text-gold/40" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
      <path d="M4 6h5v4H4zM4 14h5v4H4zM15 10h5v4h-5z" />
      <path d="M9 8h3v8h3M9 16h3" />
    </svg>
    <p class="font-display text-lg tracking-[0.14em] text-parchment">Le tirage n’a pas encore eu lieu</p>
    <p class="max-w-md text-sm leading-relaxed text-parchment-dim">
      Les huit qualifiés seront placés dans le tableau à l’issue de la phase de poules.
    </p>
  </div>
) : (
  <div>
    <p class="mb-3 text-[0.625rem] uppercase tracking-[0.18em] text-parchment-dim sm:hidden">
      Faites glisser horizontalement →
    </p>

    <div class="scroll">
      <div class="bracket">
        <div class="titles">
          <h3 class="round-title">Quarts de finale</h3>
          <span aria-hidden="true"></span>
          <h3 class="round-title">Demi-finales</h3>
          <span aria-hidden="true"></span>
          <h3 class="round-title">Grande finale</h3>
        </div>

        <div class="grid">
          <div class="col col-qf">
            {qfOrder.map(({ slot, y }) => {
              const m = qfBySlot(slot);
              return (
                <div class="node" style={`--y:${y}`}>
                  {m ? <MatchNode m={m} phase="qf" /> : <div class="placeholder">—</div>}
                </div>
              );
            })}
          </div>

          <div class="gap" aria-hidden="true">
            {gapOne.map((g) => (
              <>
                <span class="stub" style={`--y:${g.from}`}></span>
                <span class="stub" style={`--y:${g.to}`}></span>
                <span class="spine" style={`--from:${g.from};--to:${g.to}`}></span>
                <span class="out" style={`--y:${g.out}`}></span>
              </>
            ))}
          </div>

          <div class="col col-sf">
            {sfOrder.map(({ slot, y }) => {
              const m = sfBySlot(slot);
              return (
                <div class="node" style={`--y:${y}`}>
                  {m ? <MatchNode m={m} phase="sf" /> : <div class="placeholder">En attente</div>}
                </div>
              );
            })}
          </div>

          <div class="gap" aria-hidden="true">
            {gapTwo.map((g) => (
              <>
                <span class="stub" style={`--y:${g.from}`}></span>
                <span class="stub" style={`--y:${g.to}`}></span>
                <span class="spine" style={`--from:${g.from};--to:${g.to}`}></span>
                <span class="out" style={`--y:${g.out}`}></span>
              </>
            ))}
          </div>

          <div class="col col-final">
            <div class="node node-final" style={`--y:${FINAL_Y}`}>
              {fin ? <MatchNode m={fin} phase="final" /> : <div class="placeholder">En attente</div>}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
)}

<style>
  .scroll {
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .bracket {
    --gap: 3.5rem;
    --row: 6.5rem;
    min-width: 48rem;
  }

  .titles,
  .grid {
    display: grid;
    grid-template-columns: 1fr var(--gap) 1fr var(--gap) 1fr;
  }

  .titles > * {
    padding-bottom: 0.75rem;
  }

  .round-title {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    text-align: center;
  }

  /* A node is absolutely centred on its computed percentage, so a child always
     lands exactly on the midpoint of its two parents — no pixel maths. */
  .grid {
    position: relative;
    height: calc(var(--row) * 4);
  }

  .col {
    position: relative;
    grid-row: 1;
  }

  .col-qf { grid-column: 1; }
  .col-sf { grid-column: 3; }
  .col-final { grid-column: 5; }

  .node {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--y) * 1%);
    transform: translateY(-50%);
    min-width: 0;
  }

  .placeholder {
    padding: 0.85rem 0.75rem;
    border: 1px dashed color-mix(in oklab, var(--color-gold) 20%, transparent);
    text-align: center;
    font-size: 0.75rem;
    font-style: italic;
    color: color-mix(in oklab, var(--color-parchment-dim) 55%, transparent);
  }

  /* ---- connectors ---- */

  .gap {
    position: relative;
    grid-row: 1;
  }

  .stub,
  .out {
    position: absolute;
    left: 0;
    width: 50%;
    height: 1px;
    top: calc(var(--y) * 1%);
    background: color-mix(in oklab, var(--color-gold) 42%, transparent);
    transform: translateY(-0.5px);
  }

  .out {
    left: 50%;
    width: 50%;
  }

  .spine {
    position: absolute;
    left: 50%;
    width: 1px;
    top: calc(var(--from) * 1%);
    height: calc((var(--to) - var(--from)) * 1%);
    background: color-mix(in oklab, var(--color-gold) 42%, transparent);
    transform: translateX(-0.5px);
  }

  .out::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background: color-mix(in oklab, var(--color-gold) 75%, transparent);
    transform: translate(-50%, -1.5px);
  }

  @media (max-width: 640px) {
    .bracket {
      --gap: 1.75rem;
      --row: 6rem;
      min-width: 44rem;
    }
  }
</style>
