---
import type { TournamentState } from '../lib/state';
import MatchNode from './MatchNode.astro';

interface Props {
  state: TournamentState;
}

const { state } = Astro.props;

const qf = state.matches.filter((m) => m.phase === 'qf').sort((a, b) => a.slot - b.slot);
const sf = state.matches.filter((m) => m.phase === 'sf').sort((a, b) => a.slot - b.slot);
const fin = state.matches.find((m) => m.phase === 'final');

const hasBracket = qf.length > 0;

// QF1+QF3 feed SF1, QF2+QF4 feed SF2 — each pair is one visual block.
const qfPairs = [
  [qf.find((m) => m.slot === 1), qf.find((m) => m.slot === 3)],
  [qf.find((m) => m.slot === 2), qf.find((m) => m.slot === 4)],
];
const sfSlots = [sf.find((m) => m.slot === 1), sf.find((m) => m.slot === 2)];
---

{!hasBracket ? (
  <div class="card-dark texture-noise flex flex-col items-center gap-3 px-6 py-16 text-center">
    <svg viewBox="0 0 24 24" class="h-10 w-10 text-gold/40" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
      <path d="M4 6h5v4H4zM4 14h5v4H4zM15 10h5v4h-5z" />
      <path d="M9 8h3v8h3M9 16h3" />
    </svg>
    <p class="font-display text-lg tracking-[0.14em] text-parchment">Le tirage n’a pas encore eu lieu</p>
    <p class="max-w-md text-sm leading-relaxed text-parchment-dim">
      Les huit qualifiés seront placés dans le tableau à l’issue de la phase de poules.
    </p>
  </div>
) : (
  <div>
    <p class="mb-3 text-[0.625rem] uppercase tracking-[0.18em] text-parchment-dim sm:hidden">
      Faites glisser horizontalement →
    </p>

    <div class="overflow-x-auto pb-2">
      <div class="bracket">
        <div class="round round-qf">
          <h3 class="round-title">Quarts de finale</h3>
          <div class="round-body">
            {qfPairs.map((pair) => (
              <div class="pair">
                <div class="node-slot">{pair[0] ? <MatchNode m={pair[0]} phase="qf" /> : null}</div>
                <div class="node-slot">{pair[1] ? <MatchNode m={pair[1]} phase="qf" /> : null}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="round round-sf">
          <h3 class="round-title">Demi-finales</h3>
          <div class="round-body">
            {qfPairs.map((_, i) => (
              <div class="pair pair-single">
                <div class="node-slot">{sfSlots[i] ? <MatchNode m={sfSlots[i]!} phase="sf" /> : null}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="round round-final">
          <h3 class="round-title">Grande finale</h3>
          <div class="round-body">
            <div class="pair pair-single">
              <div class="node-slot">
                {fin ? <MatchNode m={fin} phase="final" /> : <p class="empty">En attente</p>}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
)}

<style>
  .bracket {
    --gap: 3rem;
    display: grid;
    grid-template-columns: 1fr var(--gap) 1fr var(--gap) 1fr;
    min-width: 46rem;
  }

  .round { display: flex; flex-direction: column; }
  .round-qf { grid-column: 1; }
  .round-sf { grid-column: 3; }
  .round-final { grid-column: 5; }

  .round-title {
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    text-align: center;
  }

  /* Every round uses the same number of equal-height blocks. A node centred in
     a block therefore lines up exactly with the midpoint of its two parents. */
  .round-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-block: 0.5rem;
  }

  .pair {
    position: relative;
    flex: 1;
    display: grid;
    grid-template-rows: 1fr 1fr;
    align-items: center;
  }

  .pair-single { grid-template-rows: 1fr; }

  .node-slot {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .empty {
    width: 100%;
    text-align: center;
    font-size: 0.75rem;
    color: var(--color-parchment-dim);
  }

  /* ---- connectors, all owned by this file so Astro scoping can't drop them ---- */

  /* QF pair: two input stubs (at 25% / 75%), a spine, and an output stub at 50% */
  .round-qf .pair::before {
    content: "";
    position: absolute;
    top: 25%;
    bottom: 25%;
    right: calc(-0.5 * var(--gap));
    width: 1px;
    background: color-mix(in oklab, var(--color-gold) 40%, transparent);
    pointer-events: none;
  }

  .round-qf .pair::after {
    content: "";
    position: absolute;
    top: 50%;
    right: calc(-1 * var(--gap));
    width: calc(0.5 * var(--gap));
    height: 1px;
    background: color-mix(in oklab, var(--color-gold) 40%, transparent);
    pointer-events: none;
  }

  /* the two horizontal stubs leaving each QF node */
  .round-qf .node-slot::after {
    content: "";
    position: absolute;
    right: calc(-0.5 * var(--gap));
    width: calc(0.5 * var(--gap));
    height: 1px;
    background: color-mix(in oklab, var(--color-gold) 40%, transparent);
    pointer-events: none;
  }
  .round-qf .node-slot:nth-child(1)::after { top: 25%; }
  .round-qf .node-slot:nth-child(2)::after { top: 75%; }

  /* SF -> final: one output stub per SF, plus a spine and the final input */
  .round-sf .pair::after {
    content: "";
    position: absolute;
    top: 50%;
    right: calc(-1 * var(--gap));
    width: calc(0.5 * var(--gap));
    height: 1px;
    background: color-mix(in oklab, var(--color-gold) 40%, transparent);
    pointer-events: none;
  }

  .round-sf .round-body::before {
    content: "";
    position: absolute;
    top: 25%;
    bottom: 25%;
    right: calc(-0.5 * var(--gap));
    width: 1px;
    background: color-mix(in oklab, var(--color-gold) 40%, transparent);
    pointer-events: none;
  }

  .round-sf .round-body {
    position: relative;
  }

  @media (max-width: 640px) {
    .bracket { --gap: 1.5rem; min-width: 42rem; }
  }
</style>
